# Copy to .env. Demo payments never contact Safaricom. Production refuses DEMO_MODE.
NODE_ENV=development
DEMO_MODE=true
PORT=3001
APP_URL=http://localhost:5173
STORAGE_DIR=./storage
# Optional absolute directory containing pdftoppm/pdftotext when not on PATH.
POPPLER_BIN=
# Leave blank ONLY for local SQLite demo. Production requires PostgreSQL.
DATABASE_URL=
DATABASE_SSL=false
# Docker Compose only: generate a strong hexadecimal password.
POSTGRES_PASSWORD=
# Run npm run admin:create; no default admin credentials exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Real generation: set DEMO_MODE=false and add your own API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
AI_IMAGES_ENABLED=false
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_PAYBILL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public HTTPS endpoint on your own host; append ?secret=<MPESA_CALLBACK_SECRET>
MPESA_CALLBACK_URL=https://vcyber.co.ke/api/mpesa/callback
MPESA_CALLBACK_SECRET=
# Production upload scanning. Install ClamAV and update its signatures.
CLAMSCAN_PATH=clamscan
# Maximum documents/requests from one visitor per hour
GENERATION_LIMIT=10
# Deliberately unset: confirm actual operating hours in the footer before launch.

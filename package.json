{
  "name": "victorious-cyber",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "db:migrate": "node server/migrate.js",
    "admin:create": "node server/create-admin.js",
    "test:browser": "node tests/browser.mjs",
    "test:browser:local": "node tests/browser-runner.mjs",
    "format": "prettier --write client/src server tests README.md vite.config.js package.json"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "docx": "^9.5.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "framer-motion": "^12.23.24",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "vite": "^7.1.12"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
